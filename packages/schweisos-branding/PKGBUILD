pkgname=schweisos-branding
pkgver=0.1.0
pkgrel=2
pkgdesc='SchweisOS visual identity assets'
arch=('any')
url='https://github.com/Schweis-Cooperative/SchweisOS'
license=('LicenseRef-SchweisOS-Brand-Assets')
depends=('hicolor-icon-theme')
source=(
  'schweisos-logo.png'
  'BRAND-ASSETS.md'
)
sha256sums=('88cfb5b1fcca38f3f5979ddab619d3885e82df84c886b983f412604f72df76bd'
            '9aa2f71540da7b6e578dfd84d3c609e07739bdf6e15265790024114ee74daf4d')

package() {
  install -Dm644 "${srcdir}/schweisos-logo.png" \
    "${pkgdir}/usr/share/schweisos/branding/schweisos-logo.png"
  install -Dm644 "${srcdir}/schweisos-logo.png" \
    "${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/schweisos.png"
  install -Dm644 "${srcdir}/schweisos-logo.png" \
    "${pkgdir}/usr/share/pixmaps/schweisos.png"
  install -Dm644 "${srcdir}/BRAND-ASSETS.md" \
    "${pkgdir}/usr/share/licenses/${pkgname}/BRAND-ASSETS.md"
}
