pkgname=schweisos-release
pkgver=0.1.0
pkgrel=1
pkgdesc='SchweisOS distribution identity metadata'
arch=('any')
url='https://github.com/Schweis-Cooperative/SchweisOS'
license=('GPL-3.0-or-later')
depends=('filesystem')
source=(
  'os-release'
  'release.json'
)
sha256sums=('24106380c04d3168afed0d30b355dcf186651d48e16c47cd01ae8945c257683c'
            'bdd503e1b74db948904f95d7308106b61460734f4d7908093054d61092f8a5fe')

package() {
  install -Dm644 "${srcdir}/os-release" \
    "${pkgdir}/usr/lib/schweisos-release/os-release"
  install -Dm644 "${srcdir}/release.json" \
    "${pkgdir}/usr/lib/schweisos-release/release.json"
}
