#!/usr/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

marker=/run/schweisos-plymouth-normal-quit

remove_marker() {
    /usr/bin/rm -f -- "$marker"
}

/usr/bin/touch -- "$marker"
trap remove_marker EXIT
trap 'exit 1' HUP INT TERM
/usr/bin/plymouth quit
trap - EXIT HUP INT TERM
