Window.SetBackgroundTopColor(0.020, 0.063, 0.133);
Window.SetBackgroundBottomColor(0.020, 0.063, 0.133);

animation.frame = 0;
animation.progress = 0;

logo.source_image = Image("schweisos.png");

# The canonical PNG is intentionally the only artwork source. The current
# motion contract follows the project-provided Windows 8 boot reference for
# timing and loading feel, while replacing every platform-specific visual with
# SchweisOS branding. The near-black stage matches the canonical logo's own
# edge tone so the opaque source image does not appear as a separate card.
logo.size = Window.GetHeight() / 3.05;
if (Window.GetWidth() < Window.GetHeight()) {
  logo.size = Window.GetWidth() / 3.05;
}
if (logo.size > 300) {
  logo.size = 300;
}
if (logo.size < 160) {
  logo.size = 160;
}

logo.image = logo.source_image.Scale(Math.Int(logo.size), Math.Int(logo.size));
logo.sprite = Sprite(logo.image);
logo.sprite.SetZ(10);
logo.sprite.SetOpacity(0);

logo.delay_frames = 36;
logo.fade_frames = 24;

# The loader is generated from the white eye in schweisos.png. Five dots chase
# each other around a compact circle, mirroring the reference animation's
# pacing without adding duplicate raster artwork.
spinner.dot_image[0] = logo.source_image.Crop(628, 330, 22, 22).Scale(5, 5);
spinner.dot_image[1] = logo.source_image.Crop(628, 330, 22, 22).Scale(6, 6);
spinner.dot_image[2] = logo.source_image.Crop(628, 330, 22, 22).Scale(7, 7);
spinner.dot_image[3] = logo.source_image.Crop(628, 330, 22, 22).Scale(8, 8);
spinner.dot_image[4] = logo.source_image.Crop(628, 330, 22, 22).Scale(9, 9);
spinner.count = 5;
spinner.phase = 0 - (Math.Pi / 2);
spinner.radius = 22;
spinner.angle_gap = 0.54;
spinner.delay_frames = 84;
spinner.fade_frames = 14;
for (index = 0; index < spinner.count; index++) {
  spinner.sprite[index] = Sprite(spinner.dot_image[0]);
  spinner.sprite[index].SetZ(11);
  spinner.sprite[index].SetOpacity(0);
}

fun layout_callback()
{
  logo_x = Window.GetX() + (Window.GetWidth() - logo.image.GetWidth()) / 2;
  logo_y = Window.GetY() + (Window.GetHeight() - logo.image.GetHeight()) / 2;
  logo_y -= 30;
  logo.sprite.SetX(logo_x);
  logo.sprite.SetY(logo_y);

  spinner_x = Window.GetX() + Window.GetWidth() / 2;
  spinner_y = logo_y + logo.image.GetHeight() + 48;
  for (index = 0; index < spinner.count; index++) {
    angle = spinner.phase - (index * spinner.angle_gap);
    dot_size = 5;
    if (index == 0) {
      dot_size = 9;
    }
    if (index == 1) {
      dot_size = 8;
    }
    if (index == 2) {
      dot_size = 7;
    }
    if (index == 3) {
      dot_size = 6;
    }
    dot_x = spinner_x + (Math.Cos(angle) * spinner.radius) - (dot_size / 2);
    dot_y = spinner_y + (Math.Sin(angle) * spinner.radius) - (dot_size / 2);
    spinner.sprite[index].SetX(dot_x);
    spinner.sprite[index].SetY(dot_y);
  }
}

fun refresh_callback()
{
  animation.frame += 1;

  logo_intro = (animation.frame - logo.delay_frames) / logo.fade_frames;
  if (logo_intro < 0) {
    logo_intro = 0;
  }
  if (logo_intro > 1) {
    logo_intro = 1;
  }
  logo_intro = logo_intro * logo_intro * (3 - (2 * logo_intro));

  spinner_intro = (animation.frame - spinner.delay_frames) / spinner.fade_frames;
  if (spinner_intro < 0) {
    spinner_intro = 0;
  }
  if (spinner_intro > 1) {
    spinner_intro = 1;
  }
  spinner_intro = spinner_intro * spinner_intro * (3 - (2 * spinner_intro));

  handoff = 1;
  if (animation.progress > 0.88) {
    handoff = (1 - animation.progress) / 0.12;
  }
  if (handoff < 0) {
    handoff = 0;
  }
  if (handoff > 1) {
    handoff = 1;
  }
  handoff = handoff * handoff * (3 - (2 * handoff));

  logo.sprite.SetOpacity(logo_intro * handoff);

  spinner.phase += 0.108;
  if (spinner.phase > (2 * Math.Pi)) {
    spinner.phase -= (2 * Math.Pi);
  }

  for (index = 0; index < spinner.count; index++) {
    dot_opacity = 0.30;
    spinner.sprite[index].SetImage(spinner.dot_image[0]);
    if (index == 0) {
      dot_opacity = 0.96;
      spinner.sprite[index].SetImage(spinner.dot_image[4]);
    }
    if (index == 1) {
      dot_opacity = 0.78;
      spinner.sprite[index].SetImage(spinner.dot_image[3]);
    }
    if (index == 2) {
      dot_opacity = 0.58;
      spinner.sprite[index].SetImage(spinner.dot_image[2]);
    }
    if (index == 3) {
      dot_opacity = 0.42;
      spinner.sprite[index].SetImage(spinner.dot_image[1]);
    }
    spinner.sprite[index].SetOpacity(spinner_intro * handoff * dot_opacity);
  }

  layout_callback();
}

fun boot_progress_callback(duration, progress)
{
  if (progress < 0) {
    progress = 0;
  }
  if (progress > 1) {
    progress = 1;
  }
  global.animation.progress = progress;
}

fun quit_callback()
{
  logo.sprite.SetOpacity(0);
  for (index = 0; index < spinner.count; index++) {
    spinner.sprite[index].SetOpacity(0);
  }
}

layout_callback();
Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(boot_progress_callback);
Plymouth.SetQuitFunction(quit_callback);
