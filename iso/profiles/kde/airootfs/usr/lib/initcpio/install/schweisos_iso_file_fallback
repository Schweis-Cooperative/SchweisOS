build() {
    add_runscript
    add_module loop

    add_binary find
    add_binary grep
    add_binary losetup
    add_binary lsblk
    add_binary mount
    add_binary umount
}

help() {
    cat <<HELPEOF
  This hook provides SchweisOS' narrow ISO-file discovery fallback for
  multiboot command lines that use native Archiso search for an ISO stored as a
  file on removable media without passing img_dev/img_loop.
HELPEOF
}
