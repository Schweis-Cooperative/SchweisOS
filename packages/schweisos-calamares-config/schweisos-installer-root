#!/usr/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

export PATH=/usr/bin

if (( EUID != 0 )); then
  printf 'schweisos installer: privileged launcher must run as root\n' >&2
  exit 1
fi
if (( $# != 0 )); then
  printf 'schweisos installer: privileged launcher accepts no arguments\n' >&2
  exit 2
fi
if [[ -z ${DISPLAY:-} || -z ${XAUTHORITY:-} || ! -r ${XAUTHORITY:-/nonexistent} ]]; then
  printf 'schweisos installer: XWayland display authorization is unavailable\n' >&2
  exit 1
fi
if [[ ! -x /usr/bin/calamares ]]; then
  printf 'schweisos installer: Calamares executable is missing\n' >&2
  exit 1
fi

# Calamares 3.4 runs its UI with administrative privileges. Native Wayland
# intentionally rejects that model, so the reviewed live-session bridge uses
# the session's XWayland authorization and forces Qt's xcb backend. Polkit
# supplies only DISPLAY and XAUTHORITY through an exact-path allow_gui action.
unset LD_LIBRARY_PATH LD_PRELOAD PYTHONHOME PYTHONPATH QML2_IMPORT_PATH \
  QT_PLUGIN_PATH QT_QPA_PLATFORMTHEME
export QT_QPA_PLATFORM=xcb

exec /usr/bin/calamares -D6
