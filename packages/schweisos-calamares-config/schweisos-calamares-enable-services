#!/usr/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

export LC_ALL=C

target_root=${1:?target root argument is required}

if [[ "$target_root" == / || -z "$target_root" ]]; then
  printf 'schweisos services: unsafe target root\n' >&2
  exit 1
fi

arch-chroot "$target_root" systemctl enable NetworkManager.service
arch-chroot "$target_root" systemctl enable sddm.service

enable_if_installed() {
  local package=$1
  local unit=$2
  if arch-chroot "$target_root" pacman -Qq -- "$package" >/dev/null 2>&1; then
    arch-chroot "$target_root" systemctl enable "$unit"
  fi
}

enable_if_installed firewalld firewalld.service
enable_if_installed cups cups.service
enable_if_installed bluez bluez.service
enable_if_installed libvirt libvirtd.service
