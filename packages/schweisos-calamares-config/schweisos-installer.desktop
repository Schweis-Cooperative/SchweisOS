[Desktop Entry]
Type=Application
Version=1.0
Name=Install SchweisOS
GenericName=System Installer
Comment=Install SchweisOS to this computer
TryExec=/usr/bin/schweisos-installer
Exec=/usr/bin/schweisos-installer
Icon=schweisos
Terminal=false
StartupNotify=true
StartupWMClass=calamares
Categories=Qt;System;
Keywords=install;installer;calamares;schweisos;
X-AppStream-Ignore=true
