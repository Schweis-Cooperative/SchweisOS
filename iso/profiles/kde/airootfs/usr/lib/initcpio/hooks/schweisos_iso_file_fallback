#!/usr/bin/ash
#
# SPDX-License-Identifier: GPL-3.0-or-later

# A file-based multiboot path can reach initramfs with Archiso's native
# archisosearchuuid contract but without an img_dev/img_loop handoff. The stock
# hook then searches for the marker on the outer removable partition, not
# inside the ISO file stored on that partition. This narrowly scoped fallback
# preserves native Archiso search first, then searches removable media for a
# SchweisOS ISO carrying the requested marker and hands its loop device back to
# Archiso. The kernel command line, not a multiboot mode label, identifies this
# runtime path.

_schweisos_search_mount=/run/schweisos/iso-file-search

_schweisos_removable_candidates() {
    lsblk -no PATH -Q 'RM == 1 && ( TYPE == "part" || TYPE == "rom" )' 2>/dev/null
}

_schweisos_wait_for_removable_candidates() {
    local remaining

    remaining="$(getarg 'rootdelay')"
    case "${remaining}" in
        ''|*[!0-9]*)
            remaining=10
            ;;
    esac

    while [ "${remaining}" -gt 0 ]; do
        if [ -n "$(_schweisos_removable_candidates)" ]; then
            return 0
        fi

        sleep 1
        remaining=$((remaining - 1))
    done

    [ -n "$(_schweisos_removable_candidates)" ]
}

_schweisos_try_explicit_archiso_device() {
    local search_dev

    mkdir -p "${_schweisos_search_mount}"

    for search_dev in "${archisodevice:-}" "$(getarg 'archisodevice')" "$(getarg 'img_dev')"; do
        [ -n "${search_dev}" ] || continue

        msg ":: Checking explicit Archiso device '${search_dev}' for '${archisosearchfilename}'"
        umount "${_schweisos_search_mount}" 2>/dev/null

        if mount -o 'x-initrd.mount' -r "${search_dev}" "${_schweisos_search_mount}" 2>/dev/null; then
            if [ -e "${_schweisos_search_mount}${archisosearchfilename}" ]; then
                umount "${_schweisos_search_mount}" 2>/dev/null
                archisodevice="${search_dev}"
                return 0
            fi
        fi
    done

    umount "${_schweisos_search_mount}" 2>/dev/null
    return 1
}

_schweisos_scan_direct_marker_on_removable() {
    local search_dev

    mkdir -p "${_schweisos_search_mount}"

    for search_dev in $(_schweisos_removable_candidates); do
        [ -b "${search_dev}" ] || continue

        msg ":: Searching for native Archiso marker '${archisosearchfilename}' in '${search_dev}'"
        umount "${_schweisos_search_mount}" 2>/dev/null

        if mount -o 'x-initrd.mount' -r "${search_dev}" "${_schweisos_search_mount}" 2>/dev/null; then
            if [ -e "${_schweisos_search_mount}${archisosearchfilename}" ]; then
                umount "${_schweisos_search_mount}" 2>/dev/null
                archisodevice="${search_dev}"
                return 0
            fi
        fi
    done

    umount "${_schweisos_search_mount}" 2>/dev/null
    return 1
}

_schweisos_scan_iso_file_on_removable() {
    local candidate marker search_dev

    marker="${archisosearchuuid}.uuid"
    mkdir -p "${_schweisos_search_mount}"

    for search_dev in $(_schweisos_removable_candidates); do
        [ -b "${search_dev}" ] || continue

        msg ":: Searching removable ISO files for '${marker}' in '${search_dev}'"
        umount "${_schweisos_search_mount}" 2>/dev/null

        if ! mount -o 'x-initrd.mount' -r "${search_dev}" "${_schweisos_search_mount}" 2>/dev/null; then
            continue
        fi

        while IFS= read -r candidate; do
            [ -f "${candidate}" ] || continue
            if grep -a -m 1 -F "${marker}" "${candidate}" >/dev/null 2>&1; then
                schweisos_iso_file="${candidate}"
                schweisos_iso_source_device="${search_dev}"
                return 0
            fi
        done <<EOF
$(find "${_schweisos_search_mount}" -type f \( -name '*.iso' -o -name '*.ISO' \) 2>/dev/null)
EOF
    done

    umount "${_schweisos_search_mount}" 2>/dev/null
    rmdir "${_schweisos_search_mount}" 2>/dev/null
    return 1
}

run_hook() {
    if [ "${mount_handler:-}" = 'archiso_loop_mount_handler' ]; then
        if [ -n "$(getarg 'img_dev')" ] && [ -n "$(getarg 'img_loop')" ]; then
            return 0
        fi
    fi

    [ -n "${archisosearchuuid:-}" ] || return 0
    [ -n "${archisosearchfilename:-}" ] || return 0
    if [ -n "$(getarg 'img_dev')" ] && [ -n "$(getarg 'img_loop')" ]; then
        return 0
    fi

    export mount_handler='schweisos_iso_file_mount_handler'
}

schweisos_iso_file_mount_handler() {
    local newroot="${1}"
    local loopdev

    if _schweisos_try_explicit_archiso_device; then
        export archisodevice
        export archisosearchuuid=''
        export archisosearchfilename=''
        archiso_mount_handler "${newroot}"
        return
    fi

    if _schweisos_wait_for_removable_candidates; then
        if _schweisos_scan_direct_marker_on_removable; then
            export archisodevice
            export archisosearchuuid=''
            export archisosearchfilename=''
            archiso_mount_handler "${newroot}"
            return
        fi

        if _schweisos_scan_iso_file_on_removable; then
            msg ":: Found SchweisOS ISO '${schweisos_iso_file}' on '${schweisos_iso_source_device}'"

            if loopdev="$(losetup --find --show --read-only "${schweisos_iso_file}")"; then
                export archisodevice="${loopdev}"
                export archisosearchuuid=''
                export archisosearchfilename=''
                archiso_mount_handler "${newroot}"

                if [ "${copytoram}" = 'y' ]; then
                    losetup -d "${loopdev}" 2>/dev/null
                    umount "${_schweisos_search_mount}" 2>/dev/null
                    rmdir "${_schweisos_search_mount}" 2>/dev/null
                fi
                return
            fi

            echo "ERROR: Setting read-only loopback device for ISO file '${schweisos_iso_file}'"
            launch_interactive_shell
        fi
    else
        msg ":: No removable media appeared before SchweisOS ISO-file fallback deadline"
    fi


    archiso_mount_handler "${newroot}"
}

# vim: set ft=sh:
