pkgname=schweisos-release
pkgver=0.2.0
pkgrel=1
pkgdesc='SchweisOS distribution identity metadata'
arch=('any')
url='https://github.com/Schweis-Cooperative/SchweisOS'
license=('GPL-3.0-or-later')
depends=('filesystem')
source=(
  'os-release'
  'release.json'
)
sha256sums=('aead22c20f9497dcf6b8c11e4926affaeb0c8c5acdb68b373e5692efc9db240f'
            'f191e2042f685db100e998aaa34857eda2a010b47264dd0ac14b7997fcf6a6f2')

package() {
  install -Dm644 "${srcdir}/os-release" \
    "${pkgdir}/usr/lib/schweisos-release/os-release"
  install -Dm644 "${srcdir}/release.json" \
    "${pkgdir}/usr/lib/schweisos-release/release.json"

  install -d "${pkgdir}/etc"
  ln -s ../usr/lib/schweisos-release/os-release \
    "${pkgdir}/etc/os-release"
}
