pkgver=0.1.0
pkgrel=1
pkgdesc='SchweisOS Calamares installer configuration'
arch=('any')
url='https://schweisos.org'
license=('GPL-3.0-or-later' 'CC-BY-SA-4.0')
depends=(
  'arch-install-scripts'
  'bash'
  'calamares'
  'dosfstools'
  'efibootmgr'
  'e2fsprogs'
  'pacman'
  'polkit'
  'schweisos-branding'
  'schweisos-keyring'
  'schweisos-mirrorlist'
  'schweisos-pacman-config'
  'schweisos-release'
  'systemd'
)
optdepends=(
  'btrfs-progs: optional Btrfs target filesystem support'
  'schweisos-grub-theme: future installer-owned GRUB alternative theme'
)
source=(
  'README.md'
  'settings.conf'
  'branding.desc'
  'finished.conf'
  'fstab.conf'
  'locale.conf'
  'partition.conf'
  'users.conf'
  'welcome.conf'
  'shellprocess-preflight.conf'
  'shellprocess-pacstrap.conf'
  'shellprocess-pacman.conf'
  'shellprocess-systemd-boot.conf'
  'shellprocess-services.conf'
  'target-packages.x86_64'
  'pacman.conf'
  'schweisos-installer'
  'schweisos-calamares-preflight'
  'schweisos-calamares-pacstrap'
  'schweisos-calamares-configure-pacman'
  'schweisos-calamares-install-systemd-boot'
  'schweisos-calamares-enable-services'
  'schweisos-installer.desktop'
)
