# SPDX-License-Identifier: GPL-3.0-or-later

pkgname=calamares
pkgver=3.4.2
pkgrel=5
pkgdesc='Distribution-independent installer framework'
arch=('x86_64')
url='https://codeberg.org/Calamares/calamares'
license=('GPL-3.0-or-later')
depends=(
  'kcoreaddons'
  'kpmcore'
  'libpwquality'
  'polkit-qt6'
  'python'
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'rsync'
  'yaml-cpp'
)
makedepends=(
  'cmake'
  'extra-cmake-modules'
  'libglvnd'
  'ninja'
  'qt6-tools'
  'qt6-translations'
)
source=(
  "calamares-${pkgver}.tar.gz::https://codeberg.org/Calamares/calamares/releases/download/v${pkgver}/calamares-${pkgver}.tar.gz"
  'schweisos-filter-live-media-devices.patch'
)
sha256sums=(
  '733bbbb00dc9f84874bd5c22960952f317ea2537565431179fa2152b2fbfdccc'
  '34066a77ec9793c16a08547da94815d82734af0b4a5decd6a0be138166f186d2'
)

prepare() {
  cd -- "${srcdir}/${pkgname}-${pkgver}"
  patch -Np1 -i "${srcdir}/schweisos-filter-live-media-devices.patch"
}

build() {
  cmake -S "${srcdir}/${pkgname}-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DWITH_QT6=ON \
    -DINSTALL_CONFIG=ON \
    -DBUILD_TESTING=OFF \
    -DSKIP_MODULES='dracut;dracutlukscfg;dummycpp;dummyprocess;dummypython;dummypythonqt;initramfs;initramfscfg;interactiveterminal;packagechooserq;services-openrc' \
    -DKDE_INSTALL_LIBDIR=lib \
    -DKDE_INSTALL_LIBEXECDIR=lib \
    -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  # SchweisOS owns one distribution-branded installer launcher through
  # schweisos-calamares-config. Fail closed if upstream changes the expected
  # launcher path, then omit the generic "Install System" entry from this
  # binary package so desktop-file precedence and menu caches cannot expose a
  # second installer.
  upstream_launcher="${pkgdir}/usr/share/applications/calamares.desktop"
  [[ -f "$upstream_launcher" && ! -L "$upstream_launcher" ]] || {
    printf 'expected upstream Calamares launcher is missing or unsafe: %s\n' \
      "$upstream_launcher" >&2
    return 1
  }
  unlink -- "$upstream_launcher"
}
