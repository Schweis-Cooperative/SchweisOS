pkgname=schweisos-branding
pkgver=0.1.0
pkgrel=3
pkgdesc='SchweisOS visual identity assets'
arch=('any')
url='https://schweisos.org'
license=('LicenseRef-SchweisOS-Brand-Assets')
depends=('hicolor-icon-theme')
source=(
  'schweisos.png'
  'BRAND-ASSETS.md'
)
sha256sums=('9d78e28d74ad677ec589dcc6c8c310d61f1a9f145519df6debcee87ff0b9ad91'
            '2d82500d672dfcea5965b4a03ef63db26e3b46585c3598916c2fdc28427f2b4c')

package() {
  install -Dm644 "${srcdir}/schweisos.png" \
    "${pkgdir}/usr/share/schweisos/branding/schweisos.png"

  install -d \
    "${pkgdir}/usr/share/icons/hicolor/1024x1024/apps" \
    "${pkgdir}/usr/share/pixmaps"
  ln -s ../../../../schweisos/branding/schweisos.png \
    "${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/schweisos.png"
  ln -s ../schweisos/branding/schweisos.png \
    "${pkgdir}/usr/share/pixmaps/schweisos.png"

  install -Dm644 "${srcdir}/BRAND-ASSETS.md" \
    "${pkgdir}/usr/share/licenses/${pkgname}/BRAND-ASSETS.md"
}
