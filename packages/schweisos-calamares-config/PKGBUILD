package() {
  install -Dm644 "${srcdir}/settings.conf" \
    "${pkgdir}/etc/calamares/settings.conf"
  install -Dm644 "${srcdir}/branding.desc" \
    "${pkgdir}/etc/calamares/branding/schweisos/branding.desc"
  install -Dm644 "${srcdir}/show.qml" \
    "${pkgdir}/etc/calamares/branding/schweisos/show.qml"

  install -Dm644 "${srcdir}/finished.conf" \
    "${pkgdir}/etc/calamares/modules/finished.conf"
  install -Dm644 "${srcdir}/fstab.conf" \
    "${pkgdir}/etc/calamares/modules/fstab.conf"
  install -Dm644 "${srcdir}/locale.conf" \
    "${pkgdir}/etc/calamares/modules/locale.conf"
  install -Dm644 "${srcdir}/partition.conf" \
    "${pkgdir}/etc/calamares/modules/partition.conf"
  install -Dm644 "${srcdir}/users.conf" \
    "${pkgdir}/etc/calamares/modules/users.conf"
  install -Dm644 "${srcdir}/welcome.conf" \
    "${pkgdir}/etc/calamares/modules/welcome.conf"

  install -Dm644 "${srcdir}/shellprocess-preflight.conf" \
    "${pkgdir}/etc/calamares/modules/shellprocess-preflight.conf"
  install -Dm644 "${srcdir}/shellprocess-pacstrap.conf" \
    "${pkgdir}/etc/calamares/modules/shellprocess-pacstrap.conf"
  install -Dm644 "${srcdir}/shellprocess-pacman.conf" \
    "${pkgdir}/etc/calamares/modules/shellprocess-pacman.conf"
  install -Dm644 "${srcdir}/shellprocess-systemd-boot.conf" \
    "${pkgdir}/etc/calamares/modules/shellprocess-systemd-boot.conf"
  install -Dm644 "${srcdir}/shellprocess-services.conf" \
    "${pkgdir}/etc/calamares/modules/shellprocess-services.conf"

  install -Dm644 "${srcdir}/target-packages.x86_64" \
    "${pkgdir}/usr/share/schweisos/calamares/target-packages.x86_64"
  install -Dm644 "${srcdir}/pacman.conf" \
    "${pkgdir}/usr/share/schweisos/calamares/pacman.conf"
  install -Dm644 "${srcdir}/README.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"

  install -Dm755 "${srcdir}/schweisos-installer" \
    "${pkgdir}/usr/bin/schweisos-installer"
  install -Dm755 "${srcdir}/schweisos-installer-root" \
    "${pkgdir}/usr/lib/schweisos-calamares/launch-root"
  install -Dm755 "${srcdir}/schweisos-installer-autostart" \
    "${pkgdir}/usr/lib/schweisos-calamares/autostart"
  install -Dm755 "${srcdir}/schweisos-calamares-preflight" \
    "${pkgdir}/usr/lib/schweisos-calamares/preflight"
  install -Dm755 "${srcdir}/schweisos-calamares-pacstrap" \
    "${pkgdir}/usr/lib/schweisos-calamares/pacstrap-target"
  install -Dm755 "${srcdir}/schweisos-calamares-configure-pacman" \
    "${pkgdir}/usr/lib/schweisos-calamares/configure-pacman"
  install -Dm755 "${srcdir}/schweisos-calamares-install-systemd-boot" \
    "${pkgdir}/usr/lib/schweisos-calamares/install-systemd-boot"
  install -Dm755 "${srcdir}/schweisos-calamares-enable-services" \
    "${pkgdir}/usr/lib/schweisos-calamares/enable-services"

  install -Dm644 "${srcdir}/schweisos-installer.desktop" \
    "${pkgdir}/usr/share/applications/schweisos-installer.desktop"
  install -Dm644 "${srcdir}/schweisos-installer-autostart.desktop" \
    "${pkgdir}/etc/xdg/autostart/schweisos-installer-autostart.desktop"
  install -Dm644 "${srcdir}/org.schweisos.installer.policy" \
    "${pkgdir}/usr/share/polkit-1/actions/org.schweisos.installer.policy"
}
