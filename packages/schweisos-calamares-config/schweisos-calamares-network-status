#!/usr/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

readonly state_dir="${SCHWEISOS_INSTALLER_STATE_DIR:-/run/schweisos-installer}"
readonly state_file="${state_dir}/network-state"
readonly probe_timeout=4
readonly connect_timeout=2
readonly default_watch_seconds=90
readonly default_watch_interval=3

write_state() {
  local state=$1
  local reason=$2
  local source=${3:-}
  local tmp_file

  install -d -m 0755 -- "$state_dir"
  tmp_file=$(mktemp --tmpdir="$state_dir" network-state.XXXXXX)
  {
    printf 'STATE=%s\n' "$state"
    printf 'REASON=%s\n' "$reason"
    printf 'SOURCE=%s\n' "$source"
    printf 'CHECKED_AT=%s\n' "$(date --utc +%Y-%m-%dT%H:%M:%SZ)"
  } >"$tmp_file"
  chmod 0644 -- "$tmp_file"
  mv -f -- "$tmp_file" "$state_file"
}

has_route() {
  if command -v ip >/dev/null 2>&1; then
    ip route get 1.1.1.1 >/dev/null 2>&1 && return 0
    ip -6 route get 2606:4700:4700::1111 >/dev/null 2>&1 && return 0
  fi

  if command -v nmcli >/dev/null 2>&1; then
    case "$(nmcli -t -f CONNECTIVITY general 2>/dev/null || true)" in
      full|limited|portal) return 0 ;;
    esac
  fi

  return 1
}

networkmanager_reports_full_connectivity() {
  command -v nmcli >/dev/null 2>&1 || return 1
  [[ "$(nmcli -t -f CONNECTIVITY general 2>/dev/null || true)" == full ]]
}

probe_https() {
  local url=$1

  command -v curl >/dev/null 2>&1 || return 2
  curl --fail --location --silent --show-error \
    --connect-timeout "$connect_timeout" \
    --max-time "$probe_timeout" \
    --output /dev/null \
    "$url" >/dev/null 2>&1
}

detect_network() {
  local url

  if ! has_route; then
    write_state offline no-route ''
    return 0
  fi

  if networkmanager_reports_full_connectivity; then
    write_state connected networkmanager-connectivity nmcli
    return 0
  fi

  for url in \
    https://schweisos.org/ \
    https://archlinux.org/; do
    if probe_https "$url"; then
      write_state connected https-probe "$url"
      return 0
    fi
  done

  if ! command -v curl >/dev/null 2>&1; then
    write_state unknown curl-unavailable ''
    return 0
  fi

  write_state offline https-probe-failed ''
}

watch_network() {
  local watch_seconds=$1
  local interval=$2
  local elapsed=0

  while (( elapsed <= watch_seconds )); do
    detect_network
    if [[ -f "$state_file" ]] && grep -Fxq 'STATE=connected' "$state_file"; then
      return 0
    fi
    sleep "$interval"
    elapsed=$(( elapsed + interval ))
  done
}

main() {
  case "${1-}" in
    '')
      (( $# == 0 )) || return 2
      detect_network
      ;;
    --watch)
      shift
      local watch_seconds=${1:-$default_watch_seconds}
      local interval=${2:-$default_watch_interval}
      [[ "$watch_seconds" =~ ^[1-9][0-9]*$ ]] || {
        printf 'usage: schweisos-calamares-network-status [--watch SECONDS [INTERVAL]]\n' >&2
        return 2
      }
      [[ "$interval" =~ ^[1-9][0-9]*$ ]] || {
        printf 'usage: schweisos-calamares-network-status [--watch SECONDS [INTERVAL]]\n' >&2
        return 2
      }
      watch_network "$watch_seconds" "$interval"
      ;;
    *)
      printf 'usage: schweisos-calamares-network-status [--watch SECONDS [INTERVAL]]\n' >&2
      return 2
      ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
