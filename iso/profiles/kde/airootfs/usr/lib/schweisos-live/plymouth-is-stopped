#!/usr/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later

# Exit success only when the watcher should reveal diagnostics. A live
# plymouthd makes ExecCondition skip the fallback service.
set -u

pid_file=/run/plymouth/pid
[[ -r "$pid_file" ]] || exit 0

pid=
IFS= read -r pid <"$pid_file" || true
[[ "$pid" =~ ^[1-9][0-9]*$ ]] || exit 0
/usr/bin/kill -0 "$pid" 2>/dev/null || exit 0

comm=
IFS= read -r comm <"/proc/${pid}/comm" || exit 0
[[ "$comm" == plymouthd ]] || exit 0

exit 1
