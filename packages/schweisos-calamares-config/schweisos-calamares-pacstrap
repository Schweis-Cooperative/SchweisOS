#!/usr/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail
shopt -s extglob

export LC_ALL=C

target_root=${1:?target root argument is required}
package_list=/usr/share/schweisos/calamares/target-packages.x86_64
pacman_config=/usr/share/schweisos/calamares/pacman.conf

if [[ "$target_root" == / || -z "$target_root" ]]; then
  printf 'schweisos pacstrap: unsafe target root\n' >&2
  exit 1
fi
if [[ ! -d "$target_root" ]] || ! findmnt --target "$target_root" >/dev/null 2>&1; then
  printf 'schweisos pacstrap: target root is not mounted: %s\n' "$target_root" >&2
  exit 1
fi
if [[ ! -f "$package_list" || -L "$package_list" ]]; then
  printf 'schweisos pacstrap: package list is missing or unsafe\n' >&2
  exit 1
fi
if [[ ! -f "$pacman_config" || -L "$pacman_config" ]]; then
  printf 'schweisos pacstrap: pacman configuration is missing or unsafe\n' >&2
  exit 1
fi

packages=()
while IFS= read -r line; do
  line=${line%%#*}
  line=${line##+([[:space:]])}
  line=${line%%+([[:space:]])}
  [[ -n "$line" ]] || continue
  packages+=("$line")
done < "$package_list"

if (( ${#packages[@]} == 0 )); then
  printf 'schweisos pacstrap: package list is empty\n' >&2
  exit 1
fi

pacstrap -K -C "$pacman_config" "$target_root" "${packages[@]}"
