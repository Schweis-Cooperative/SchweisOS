Window.SetBackgroundTopColor(0.020, 0.063, 0.133);
Window.SetBackgroundBottomColor(0.024, 0.075, 0.149);

animation.frame = 0;
animation.progress = 0;
animation.intro = 0;

logo.source_image = Image("schweisos.png");

# The canonical PNG is intentionally the only artwork source. A full-screen,
# low-opacity ambient layer derived from it lets the splash share the same
# dark-blue field as the logo and reduces the visible edge of the opaque source
# image without copying or inventing another logo asset.
ambient.size = Window.GetWidth();
if (Window.GetHeight() > ambient.size) {
  ambient.size = Window.GetHeight();
}
ambient.size = Math.Int(ambient.size * 1.08);
ambient.image = logo.source_image.Scale(ambient.size, ambient.size);
ambient.sprite = Sprite(ambient.image);
ambient.sprite.SetZ(1);
ambient.sprite.SetOpacity(0);

logo.base_size = Window.GetHeight() / 3.05;
if (Window.GetWidth() < Window.GetHeight()) {
  logo.base_size = Window.GetWidth() / 3.05;
}
if (logo.base_size > 340) {
  logo.base_size = 340;
}
if (logo.base_size < 178) {
  logo.base_size = 178;
}

# Pre-render a narrow scale range once. Refreshes only swap cached images,
# avoiding repeated resampling of the canonical 1254px logo during early boot.
logo.frame_count = 21;
for (index = 0; index < logo.frame_count; index++) {
  scale = 0.992 + (index * 0.0018);
  frame_size = Math.Int(logo.base_size * scale);
  logo.image[index] = logo.source_image.Scale(frame_size, frame_size);
}
logo.current_frame = 10;
logo.sprite = Sprite(logo.image[logo.current_frame]);
logo.sprite.SetZ(10);
logo.sprite.SetOpacity(0);

# A second, very restrained logo-derived aura gives the center a softer depth
# cue. It remains tied to schweisos.png and is not a separate artwork source.
logo.aura_image = logo.source_image.Scale(Math.Int(logo.base_size * 1.055), Math.Int(logo.base_size * 1.055));
logo.aura = Sprite(logo.aura_image);
logo.aura.SetZ(8);
logo.aura.SetOpacity(0);

# The loading trail is sampled from the white eye in the canonical logo. The
# elliptical motion avoids a generic terminal-era spinner while staying quiet.
spinner.dot_image[0] = logo.source_image.Crop(624, 325, 32, 32).Scale(6, 6);
spinner.dot_image[1] = logo.source_image.Crop(624, 325, 32, 32).Scale(8, 8);
spinner.dot_image[2] = logo.source_image.Crop(624, 325, 32, 32).Scale(10, 10);
spinner.count = 12;
spinner.phase = 0;
spinner.radius_x = 34;
spinner.radius_y = 11;
for (index = 0; index < spinner.count; index++) {
  spinner.sprite[index] = Sprite(spinner.dot_image[0]);
  spinner.sprite[index].SetZ(11);
  spinner.sprite[index].SetOpacity(0);
}

fun layout_callback()
{
  ambient_x = Window.GetX() + (Window.GetWidth() - ambient.image.GetWidth()) / 2;
  ambient_y = Window.GetY() + (Window.GetHeight() - ambient.image.GetHeight()) / 2;
  ambient.sprite.SetX(ambient_x);
  ambient.sprite.SetY(ambient_y);

  logo_x = Window.GetX() + (Window.GetWidth() - logo.image[logo.current_frame].GetWidth()) / 2;
  logo_y = Window.GetY() + (Window.GetHeight() - logo.image[logo.current_frame].GetHeight()) / 2;
  logo_y -= 22;
  logo_y += (1 - animation.intro) * 14;
  logo_y += Math.Sin(animation.frame * ((2 * Math.Pi) / 190)) * 1.4;
  logo.sprite.SetX(logo_x);
  logo.sprite.SetY(logo_y);

  aura_x = Window.GetX() + (Window.GetWidth() - logo.aura_image.GetWidth()) / 2;
  aura_y = Window.GetY() + (Window.GetHeight() - logo.aura_image.GetHeight()) / 2;
  aura_y -= 22;
  logo.aura.SetX(aura_x);
  logo.aura.SetY(aura_y);

  spinner_x = Window.GetX() + Window.GetWidth() / 2;
  spinner_y = Window.GetY() + Window.GetHeight() / 2 + logo.base_size / 2 + 42;
  for (index = 0; index < spinner.count; index++) {
    angle = ((2 * Math.Pi) / spinner.count) * index;
    dot_x = spinner_x + (Math.Cos(angle) * spinner.radius_x);
    dot_y = spinner_y + (Math.Sin(angle) * spinner.radius_y);
    dot_x -= spinner.dot_image[1].GetWidth() / 2;
    dot_y -= spinner.dot_image[1].GetHeight() / 2;
    spinner.sprite[index].SetX(dot_x);
    spinner.sprite[index].SetY(dot_y);
  }
}

fun refresh_callback()
{
  animation.frame += 1;
  if (animation.intro < 1) {
    animation.intro += 0.035;
  }
  if (animation.intro > 1) {
    animation.intro = 1;
  }

  breath = (Math.Cos(animation.frame * ((2 * Math.Pi) / 170)) + 1) / 2;
  next_logo_frame = Math.Int(breath * (logo.frame_count - 1));
  if (next_logo_frame != logo.current_frame) {
    logo.current_frame = next_logo_frame;
    logo.sprite.SetImage(logo.image[logo.current_frame]);
  }

  logo.sprite.SetOpacity(animation.intro * (0.955 + (breath * 0.035)));
  logo.aura.SetOpacity(animation.intro * (0.055 + (breath * 0.035)));
  ambient.sprite.SetOpacity(animation.intro * (0.070 + (breath * 0.025)));

  spinner.phase += 0.085;
  if (spinner.phase >= spinner.count) {
    spinner.phase -= spinner.count;
  }
  spinner_head = Math.Int(spinner.phase);

  spinner_finish_opacity = 1;
  if (animation.progress > 0.92) {
    spinner_finish_opacity = (1 - animation.progress) / 0.08;
  }
  if (spinner_finish_opacity < 0) {
    spinner_finish_opacity = 0;
  }

  for (index = 0; index < spinner.count; index++) {
    distance = spinner_head - index;
    if (distance < 0) {
      distance += spinner.count;
    }

    dot_opacity = 0.10 + ((spinner.count - distance - 1) * 0.045);
    spinner.sprite[index].SetImage(spinner.dot_image[0]);
    if (distance == 1) {
      dot_opacity = 0.64;
      spinner.sprite[index].SetImage(spinner.dot_image[1]);
    }
    if (distance == 0) {
      dot_opacity = 0.94;
      spinner.sprite[index].SetImage(spinner.dot_image[2]);
    }

    spinner.sprite[index].SetOpacity(
      animation.intro * spinner_finish_opacity * dot_opacity
    );
  }

  layout_callback();
}

fun boot_progress_callback(duration, progress)
{
  if (progress < 0) {
    progress = 0;
  }
  if (progress > 1) {
    progress = 1;
  }
  global.animation.progress = progress;
}

fun quit_callback()
{
  ambient.sprite.SetOpacity(0.07);
  logo.aura.SetOpacity(0.04);
  logo.sprite.SetOpacity(0.99);
  for (index = 0; index < spinner.count; index++) {
    spinner.sprite[index].SetOpacity(0);
  }
}

layout_callback();
Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(boot_progress_callback);
Plymouth.SetQuitFunction(quit_callback);
