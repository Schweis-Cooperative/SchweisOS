_schweisos_os_release_target='../usr/lib/schweisos-release/os-release'
_arch_os_release_target='../usr/lib/os-release'

_schweisos_apply_os_release() {
  if [ ! -e /usr/lib/schweisos-release/os-release ]; then
    echo 'schweisos-release: /usr/lib/schweisos-release/os-release is missing; leaving /etc/os-release unchanged.' >&2
    return 0
  fi

  if [ -L /etc/os-release ]; then
    current_target="$(readlink /etc/os-release)"
    case "${current_target}" in
      "${_arch_os_release_target}"|'/usr/lib/os-release'|"${_schweisos_os_release_target}"|'/usr/lib/schweisos-release/os-release')
        ln -sfn "${_schweisos_os_release_target}" /etc/os-release
        echo 'schweisos-release: /etc/os-release now points to SchweisOS identity metadata.'
        ;;
      *)
        echo "schweisos-release: /etc/os-release points to ${current_target}; leaving it unchanged." >&2
        ;;
    esac
  elif [ ! -e /etc/os-release ]; then
    ln -s "${_schweisos_os_release_target}" /etc/os-release
    echo 'schweisos-release: created /etc/os-release symlink for SchweisOS identity metadata.'
  else
    echo 'schweisos-release: /etc/os-release is not a symlink; leaving it unchanged.' >&2
  fi
}

post_install() {
  _schweisos_apply_os_release
}

post_upgrade() {
  _schweisos_apply_os_release
}

post_remove() {
  if [ -L /etc/os-release ]; then
    current_target="$(readlink /etc/os-release)"
    case "${current_target}" in
      "${_schweisos_os_release_target}"|'/usr/lib/schweisos-release/os-release')
        ln -sfn "${_arch_os_release_target}" /etc/os-release
        echo 'schweisos-release: restored /etc/os-release to Arch vendor metadata.'
        ;;
    esac
  fi
}
