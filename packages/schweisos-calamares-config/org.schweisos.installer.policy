<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Schweis Project</vendor>
  <vendor_url>https://schweisos.org</vendor_url>

  <action id="org.schweisos.installer.launch">
    <description>Start the SchweisOS installer</description>
    <message>Authentication is required to start the SchweisOS installer</message>
    <icon_name>schweisos</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/schweisos-calamares/launch-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
